# ══════════════════════════════════════════════
# TradeX-Pro — .env.example
# Bu faylı kopyalayın → .env adlandırın
# Öz API açarlarınızı daxil edin
# HEÇVAXT .env faylını Git-ə commit etməyin!
# ══════════════════════════════════════════════

# ── OpenAI ─────────────────────────────────────
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o
OPENAI_DAILY_TOKEN_LIMIT=50000

# ── Telegram ───────────────────────────────────
# BotFather-dan alın: t.me/BotFather → /newbot
TELEGRAM_BOT_TOKEN=xxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Telegram-da @userinfobot-a yazın, o sizin chat_id-nizi göstərər
TELEGRAM_CHAT_ID=123456789

# ── Binance (Paper Trading üçün Read-only açar kifayətdir) ──
BINANCE_API_KEY=
BINANCE_SECRET=
# ÖNƏMLİ: Binance API açarında "Withdraw" icazəsini HEÇVAXT verməyin!

# ── Alpaca (ABŞ Səhmlər — Paper Trading pulsuz) ──────────────
ALPACA_API_KEY=
ALPACA_SECRET=

# ── Xəbər API ──────────────────────────────────
# newsapi.org saytından pulsuz açar alın
NEWSAPI_KEY=

# ── Ticarət Rejimi ─────────────────────────────
# "paper" = simulyasiya (Faza 1 və 2)
# "live"  = real ticarət (yalnız Faza 3, /promote sonrası)
TRADING_MODE=paper
INITIAL_CAPITAL=1000

# ── Risk Parametrləri ──────────────────────────
MAX_RISK_PER_TRADE=0.02
MAX_OPEN_POSITIONS=3
DAILY_DRAWDOWN_LIMIT=0.05
WEEKLY_DRAWDOWN_LIMIT=0.10

# ── Siqnal Parametrləri ────────────────────────
SIGNAL_THRESHOLD=60
STRONG_SIGNAL_THRESHOLD=75

# ── Qeydiyyat ──────────────────────────────────
LOG_LEVEL=INFO
